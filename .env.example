OPENAI_API_KEY=sk-replace-me
HONEYCOMB_API_KEY=replace-me
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
OTEL_SEMCONV_STABILITY_OPT_IN=http,database,gen_ai_latest_experimental

# Optional: set to "true" to disable redaction and send full prompt/response
# content to Honeycomb too (e.g. local dev with no real user data). Default
# is to strip it before the Honeycomb export regardless of the above.
# OTEL_GENAI_CAPTURE_CONTENT=true
